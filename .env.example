# InnerOS FieldOps local-first configuration.
# Copy to .env locally if needed. Never commit real secrets.

# local | bedrock
FIELDOPS_MODEL_PROVIDER=local

# Local model/runtime metadata for evidence receipts and routing logs.
FIELDOPS_LOCAL_MODEL_ID=inneros-local-default
FIELDOPS_LOCAL_ENDPOINT=http://127.0.0.1:8000/v1

# AWS/Bedrock optional path. Required only when FIELDOPS_MODEL_PROVIDER=bedrock.
AWS_REGION=us-west-2
FIELDOPS_BEDROCK_MODEL_ID=

# Optional Strands/AgentCore metadata. The core demo/tests do not require it.
FIELDOPS_STRANDS_ENABLED=0
FIELDOPS_AGENT_NAME=InnerOSFieldOps
FIELDOPS_ROUTE=local-edge
FIELDOPS_ROUTE_REASON=privacy_and_device_locality
